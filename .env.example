# Graph Database Benchmark Environment Configuration Template
# Copy this file to .env and configure your local or cloud credentials.

# 1. CognoDB Cloud Configuration (Required for CognoDB Benchmarks)
COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.com:7687
COGNODB_USER=<your-cognodb-username>
COGNODB_PASSWORD=<your-cognodb-password>

# 2. Local Memgraph Configuration
MEMGRAPH_URI=<your-memgraph-uri>

# 3. Local FalkorDB Configuration
FALKORDB_HOST=<your-falkordb-host>
FALKORDB_PORT=<your-falkordb-port>

# 4. Local Containerized KùzuDB Configuration
KUZU_HOST=<your-kuzu-host>
KUZU_PORT=<your-kuzu-port>

# 5. Local Apache AGE Configuration
AGE_HOST=<your-age-host>
AGE_PORT=<your-age-port>
AGE_USER=<your-age-username>
AGE_PASSWORD=<your-age-password>
AGE_DB=<your-age-database>
